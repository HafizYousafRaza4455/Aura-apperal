// Aura Apparel Luxury Storefront - Prisma Database Schema
// Optimized for PostgreSQL with multi-variant SKUs, real-time inventory reservations, and Staff RBAC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANDISER
  FULFILLMENT
  SUPER_ADMIN
}

enum Category {
  OUTERWEAR
  ESSENTIALS
  SUMMER_DROP
}

enum ProductBadge {
  EXCLUSIVE
  NEW_ARRIVAL
  BESTSELLER
  SUMMER_DROP
}

enum ProductSize {
  XS
  S
  M
  L
  XL
  ONE_SIZE
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

enum ReservationStatus {
  ACTIVE
  COMMITTED
  EXPIRED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  addresses     Address[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home") // e.g. "Milan Residence", "Primary Atelier"
  recipient   String
  street      String
  city        String
  state       String?
  postalCode  String
  country     String
  isDefault   Boolean  @default(false)
  measurements Json?   // Bespoke atelier sizing notes (chest, waist, sleeve, inseam)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  subtitle    String
  price       Float
  category    Category
  badge       ProductBadge?
  description String           @db.Text
  details     String[]         // List of luxury fabrication details
  featured    Boolean          @default(false)
  colors      ProductColor[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
  @@index([featured])
}

model ProductColor {
  id             String           @id @default(cuid())
  productId      String
  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  hex            String
  image          String
  secondaryImage String?
  variants       ProductVariant[]

  @@index([productId])
}

model ProductVariant {
  id            String             @id @default(cuid())
  productId     String
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId       String
  color         ProductColor       @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size          ProductSize
  sku           String             @unique
  inventory     Inventory?
  reservations  StockReservation[]
  orderItems    OrderItem[]

  @@index([productId])
  @@index([colorId])
}

model Inventory {
  id        String         @id @default(cuid())
  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stock     Int            @default(0) // Physical units in warehouse
  reserved  Int            @default(0) // Temporary reserved units in active checkouts
  warehouse String         @default("MILAN_ATELIER")
  updatedAt DateTime       @updatedAt
}

model StockReservation {
  id         String            @id @default(cuid())
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int               @default(1)
  sessionId  String            // Checkout session or cart identifier
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime          // 10 minutes temporary hold
  createdAt  DateTime          @default(now())

  @@index([variantId])
  @@index([sessionId])
  @@index([expiresAt])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerEmail   String
  customerName    String
  status          OrderStatus  @default(PENDING)
  paymentIntentId String?      @unique
  currency        String       @default("USD")
  subtotal        Float
  shippingCost    Float        @default(0)
  tax             Float        @default(0)
  grandTotal      Float
  shippingAddress Json?        // Structured address object
  items           OrderItem[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productTitle String
  colorName    String
  size         String
  quantity     Int
  unitPrice    Float
  lineTotal    Float

  @@index([orderId])
}
